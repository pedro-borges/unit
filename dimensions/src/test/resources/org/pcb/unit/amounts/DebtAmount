package org.pcb.unit.amounts

import org.pcb.unit.Amount
import org.pcb.unit.CompositeUnit
import org.pcb.unit.U2
import org.pcb.unit.Unit
import org.pcb.unit.amounts.base.Numeric.NUMERIC
import org.pcb.unit.convert
import org.pcb.unit.dimensions.Currency
import org.pcb.unit.dimensions.Debt
import org.pcb.unit.dimensions.Scalar
import org.pcb.unit.dimensions.Time
import org.pcb.unit.div
import org.pcb.unit.times
import org.pcb.unit.toBigDecimal

open class DebtAmount<C : Unit<Currency>, T : Unit<Time>>(
        amount: Number,
        unit: U2<C, T>)
    : Amount<Debt>(amount = amount.toBigDecimal(),
                   unit = CompositeUnit(
                       domain = Debt::class,
                       units = mapOf(unit.first to 1,
                                     unit.second to 1)))
{
    val currency = unit.first
    val time = unit.second

$operators
}
